@model IEnumerable<EmailLog>
@{
    ViewData["Title"] = "Email Logs";
}

<section class="section-block">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <h1>Email Logs</h1>
            <div class="trip-actions">
                <form asp-action="RefreshData" method="post" class="d-inline">
                    <button class="btn btn-primary">Refresh Data</button>
                </form>
                <a class="btn btn-outline-primary" asp-action="SendTestEmail">Send Test Email</a>
                <a class="btn btn-outline-primary" asp-action="Dashboard">Dashboard</a>
            </div>
        </div>
        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>ID</th><th>Recipient</th><th>Subject</th><th>Status</th><th>Reservation</th><th>Created</th><th>Sent</th><th>Error</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.RecipientEmail</td>
                        <td>@item.Subject</td>
                        <td><span class="badge @(item.Status == "Sent" ? "bg-success" : item.Status == "Failed" ? "bg-danger" : "bg-secondary")">@item.Status</span></td>
                        <td>#@item.ReservationId</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(item.SentAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td class="email-error-cell">@item.ErrorMessage</td>
                        <td class="text-end">
                            @if (item.Status != "Sent")
                            {
                                <form asp-action="ResendEmail" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-primary">Resend Email</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
