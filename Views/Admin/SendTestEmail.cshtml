@model TestEmailViewModel
@{
    ViewData["Title"] = "Send Test Email";
}

<section class="section-block">
    <div class="container narrow-container">
        <div class="form-shell">
            <h1>Send Test Email</h1>
            <form asp-action="SendTestEmail" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="RecipientEmail" class="form-label"></label>
                    <input asp-for="RecipientEmail" class="form-control" placeholder="test@example.com" />
                    <span asp-validation-for="RecipientEmail" class="text-danger"></span>
                </div>
                <div class="trip-actions">
                    <button class="btn btn-primary">Send Test Email</button>
                    <a class="btn btn-outline-primary" asp-action="EmailLogs">Email Logs</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
