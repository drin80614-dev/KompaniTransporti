@model AdminUserCreateViewModel
@{
    ViewData["Title"] = "Shto admin";
}

<section class="section-block">
    <div class="container narrow-container">
        <div class="form-shell">
            <h1>Shto admin përdorues</h1>
            <form asp-action="CreateUser" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<AdminRole>()"></select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                </div>
                <button class="btn btn-primary mt-4">Ruaj përdoruesin</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
