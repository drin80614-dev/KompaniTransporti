@model IEnumerable<Ticket>
@{
    ViewData["Title"] = "Admin Tickets";
}

<section class="section-block">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <h1>Biletat e shitura</h1>
            <a class="btn btn-outline-primary" asp-action="Dashboard">Dashboard</a>
        </div>
        <div class="table-shell">
            <table class="table table-hover align-middle">
                <thead><tr><th>Nr. Biletës</th><th>Pasagjeri</th><th>Destinacioni</th><th>Data</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.TicketNumber</td>
                        <td>@item.Reservation?.Customer?.FirstName @item.Reservation?.Customer?.LastName</td>
                        <td>@item.Reservation?.Trip?.Destination</td>
                        <td>@item.IssuedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
